# tests/fixtures/full.env: .env.example with an example instance (every component) and dummy secrets (tests/golden.sh).
# Some values quoted, as the wizards' write_env leaves them: the output must not change.
# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

# Your domain (DNS at Infomaniak), no subdomain
DOMAIN=example.com
# Second domain (also at Infomaniak) serving the same sites; DOMAIN stays canonical
DOMAIN_ALIAS=example.org

# The Fedora box's NetBird IP:  ip -4 -o addr show wt0 | awk '{print $4}' | cut -d/ -f1
NETBIRD_IP=100.64.0.10

# Your user's IDs on the host (id -u / id -g), so files in ./consume are writable
HOST_UID=1000
HOST_GID=1000

# Which components run (setup/components/*.toml): written by ./homelab setup (or ./homelab configure on
# an install from before). COMPOSE_PROFILES is compose's own key: the components that have containers.
COMPONENTS=core,mesh,public-access,paperless,local-ai,media-library,jellyfin,plex,music,photos,second-disk,backups,offsite,heartbeat,audiobooks,budget,bookmarks,pdf,reading,files,share,ssh-sso,terminal,home-assistant,adblock,chores,things,family-tree,notes,wiki,news,games,places,ntfy,n8n
COMPOSE_PROFILES=paperless,local-ai,jellyfin,music,photos,audiobooks,budget,bookmarks,pdf,reading,files,share,ssh-sso,terminal,home-assistant,adblock,chores,things,family-tree,notes,wiki,news,games,places,ntfy,n8n

# --- Your instance: who and where. Read by compose, Ansible (ansible/vars.yml), the scripts and wizards ---
# Your login on this PC, also your admin username in Authentik (lowercase). The repo is /home/<it>/homelab.
ADMIN_USER='alex'
# Where the homelab's own mails go: failed jobs, drift, the outside heartbeat
NOTIFY_TO=you@example.org
# This PC's peer name in the NetBird dashboard (the reverse proxy services target it)
NETBIRD_PEER=homelab
# What the LAN may reach on this PC itself (firewall role), besides DHCPv6, mDNS and NetBird's port: firewalld
# services (firewall-cmd --get-services) or PORT/PROTO, spaces between. The homelab answers only over NetBird.
LAN_ALLOW=samba-client 51413/tcp
# The containers' time zone (tz database name, e.g. Europe/Zurich, America/New_York)
TIME_ZONE=Europe/Zurich
# Paperless OCR: Tesseract language codes joined with + (deu, fra, eng, ita, spa, …)
OCR_LANGUAGES=deu+fra+eng
# GPU for video transcoding (VAAPI) in Jellyfin and Immich: ls -l /dev/dri/by-path/ (RENDER_GID below)
RENDER_DEVICE=/dev/dri/renderD128
# Second disk for photos and files (immich-wizard.sh formats it): its stable name, and once formatted
# its filesystem UUID (blkid -s UUID -o value <disk>). ls -l /dev/disk/by-id/ | grep -v part
PHOTOS_DISK=/dev/disk/by-id/nvme-EXAMPLE_SSD_0001
PHOTOS_UUID='00000000-0000-4000-8000-000000000001'
# How sign-in pages, mails and apps name this homelab (e.g. Smith), and the same as a short lowercase
# id (e.g. smith) for file and object names. Keep BRAND_SLUG once set: Authentik stores it in its objects.
BRAND=Example
BRAND_SLUG=example
# Title of the sign-in page
SIGNIN_TITLE=Sign in to Example
# Your username in Authentik exactly as written there (capitals matter; empty = ADMIN_USER), your name
ADMIN_LOGIN=Alex
ADMIN_NAME=Alex Example
# Example phone number on the sign-up form; admin sign-ins from outside HOME_COUNTRY (ISO code) mail the admins
PHONE_EXAMPLE="+44 7700 900123"
HOME_COUNTRY=GB
HOME_COUNTRY_NAME=the United Kingdom
# Logos and icons: branding/default, or your own folder with the same files (./homelab configure copies them)
BRANDING_DIR=branding/default
# Layout on the disks; these are the defaults, change only on a new install
NVME1_DIR=/srv/nvme1
PHOTOS_COPY_DIR=/srv/photos-copy
FILES_COPY_DIR=/srv/files-copy

# --- Authentik ---
AUTHENTIK_TAG=2026.8.3
# openssl rand -base64 60 | tr -d '\n'
AK_SECRET_KEY=golden-ak-secret-key
# openssl rand -base64 36 | tr -d '\n'
AK_PG_PASS=golden-ak-pg-pass

# --- Paperless ---
PAPERLESS_TAG=3.3.0
# Office files and e-mails (Paperless' own compose file names these versions): docker.io/gotenberg/gotenberg,
# docker.io/apache/tika
PAPERLESS_GOTENBERG_TAG=8.37.0
PAPERLESS_TIKA_TAG=3.3.1.0
# openssl rand -base64 48 | tr -d '\n'
PAPERLESS_SECRET_KEY=golden-paperless-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=golden-paperless-admin-password
# Paperless AI (runbook step 6b): local Ollama on the NVIDIA card. Pull a model before switching:
# docker compose exec ollama ollama pull <model>
OLLAMA_TAG=0.40.7
PAPERLESS_AI_MODEL=gemma4:12b
PAPERLESS_AI_EMBEDDING_MODEL=bge-m3
# Fill client_id / secret from Authentik (runbook step 5). Keep it on ONE line, in single quotes.
PAPERLESS_OIDC_JSON='{"openid_connect":{"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"authentik","name":"Example account","client_id":"CHANGE_ME","secret":"CHANGE_ME","settings":{"server_url":"http://auth.example.com/application/o/paperless/.well-known/openid-configuration"}}]}}'
# Set to true after SSO is linked and tested (runbook step 6)
PAPERLESS_SSO_ONLY=false

# --- Jellyfin ---
# The same media folder Plex uses (mounted read-only into Jellyfin). Must exist before
# `docker compose up`, and hold only media: it gets a shared SELinux label (`z`) once.
MEDIA_DIR=/srv/media
JELLYFIN_TAG=12.2
# Only for hardware transcoding (see docker-compose.yml): getent group render | cut -d: -f3
RENDER_GID=golden-render-gid

# --- Navidrome (music, MEDIA_DIR/Music) ---
NAVIDROME_TAG=0.64.2
# Encrypts the users' Subsonic passwords in Navidrome's DB: openssl rand -base64 36 | tr -d '\n/+='
NAVIDROME_PASSWORD_KEY=golden-navidrome-password-key

# --- Immich (photos.<domain>, RUNBOOK.md step 7c) ---
IMMICH_TAG=v3.3.5
# Library: the second NVMe (rhel-home), mounted here by fstab
IMMICH_UPLOAD_DIR='/srv/photos'
# Letters and digits only (Immich requirement): openssl rand -base64 36 | tr -dc A-Za-z0-9
IMMICH_DB_PASSWORD=golden-immich-db-password
# Authentik OIDC app "immich" (authentik/family.yaml): openssl rand -base64 48 | tr -d '\n/+='
IMMICH_OIDC_CLIENT_SECRET=golden-immich-oidc-client-secret
# Local break-glass admin (immich/setup.sh). Password: openssl rand -base64 24 | tr -d '\n/+='
IMMICH_ADMIN_EMAIL=admin@example.org
IMMICH_ADMIN_PASSWORD=golden-immich-admin-password
# Written by immich/setup.sh (the local admin's API key; later runs use it)
IMMICH_API_KEY=golden-immich-api-key

# HTTPS (RUNBOOK.md "HTTPS"): Infomaniak API token, scopes domain:read dns:read dns:write.
# Create it at https://manager.infomaniak.com/v3/infomaniak-api
INFOMANIAK_API_TOKEN=CHANGE_ME

# --- Public access (RUNBOOK.md "Public access") ---
# NetBird reverse proxy cluster target for the wildcard CNAMEs (shown under Custom Domains)
NETBIRD_PROXY_CLUSTER=golden-netbird-proxy-cluster
# Authentik mail via Proton SMTP. The password is a Proton SMTP token for USERNAME.
AUTHENTIK_EMAIL__HOST=smtp.protonmail.ch
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__USERNAME=noreply@example.org
AUTHENTIK_EMAIL__PASSWORD=golden-authentik-email--password
AUTHENTIK_EMAIL__FROM="Example <noreply@example.org>"
# Jellyfin LDAP (authentik/jellyfin-ldap.yaml). Bind password: openssl rand -base64 36 | tr -d '\n/+='
JELLYFIN_LDAP_BIND_PASSWORD=golden-jellyfin-ldap-bind-password
# Token of the Authentik outpost "ldap" (Applications → Outposts → ldap → View deployment info)
AK_LDAP_OUTPOST_TOKEN=golden-ak-ldap-outpost-token
# Jellyfin SSO plugin ↔ Authentik OIDC app "jellyfin" (authentik/family.yaml):
# openssl rand -base64 48 | tr -d '\n/+='
JELLYFIN_OIDC_CLIENT_SECRET=golden-jellyfin-oidc-client-secret
# Listen port the NetBird TLS services got (9443: the eu1 cluster never opened 443 or 8443 for TLS services)
NETBIRD_PROXY_PORT=9443

# --- SSH via Authentik (RUNBOOK.md step 10); both filled by ./authentik/setup-ssh.sh ---
SSH_LDAP_BIND_PASSWORD=golden-ssh-ldap-bind-password
# Token of the Authentik outpost "ldap-ssh"
AK_LDAP_SSH_OUTPOST_TOKEN=golden-ak-ldap-ssh-outpost-token

# --- Automatic backups (backup.sh). age PUBLIC key (age1…) from `age-keygen` on the laptop.
# The private key stays off this box (laptop + Proton Pass).
BACKUP_AGE_RECIPIENT=golden-backup-age-recipient

# --- More apps (RUNBOOK.md step 7d). All optional for compose: each app only needs its own lines. ---
# Outside heartbeat (heartbeat.sh, every 5 min): the ping URL of a check at healthchecks.io
# (period 5 min, grace 15 min, alerts to NOTIFY_TO). Empty = heartbeat off.
HEARTBEAT_URL=golden-heartbeat-url
# Read-only API key of that healthchecks.io project (Settings → API Access → read-only), so the
# home page can show healthchecks.io's own view (RUNBOOK.md 7e). Empty = left out.
HEARTBEAT_API_KEY_RO=golden-heartbeat-api-key-ro
# Home Assistant + Matter server (NetBird only)
HA_TAG=2026.10.4
MATTER_TAG=1.5.5
# AdGuard Home (DNS for NetBird peers on NETBIRD_IP:53)
ADGUARD_TAG=v0.107.79
# Audiobookshelf (books.<domain>). Inside MEDIA_DIR, mounted read-only.
ABS_TAG=2.37.2
AUDIOBOOKS_DIR=/srv/media/audiobooks
# Authentik OIDC app "audiobookshelf" (authentik/apps.yaml): openssl rand -base64 48 | tr -d '\n/+='
ABS_OIDC_CLIENT_SECRET=golden-abs-oidc-client-secret
# Actual Budget (budget.<domain>). Authentik OIDC app "actual": openssl rand -base64 48 | tr -d '\n/+='
ACTUAL_TAG=26.10.0
ACTUAL_OIDC_CLIENT_SECRET=golden-actual-oidc-client-secret
# Karakeep (links.<domain>)
KARAKEEP_TAG=0.34.1
KARAKEEP_CHROME_TAG=156.0.8078.47-r1
KARAKEEP_MEILI_TAG=v1.41.0
# Same Ollama as Paperless AI (pull it first)
KARAKEEP_AI_MODEL=gemma4:12b
# openssl rand -base64 36 | tr -d '\n'
KARAKEEP_NEXTAUTH_SECRET=golden-karakeep-nextauth-secret
# openssl rand -base64 36 | tr -dc 'A-Za-z0-9'
KARAKEEP_MEILI_KEY=golden-karakeep-meili-key
# Authentik OIDC app "karakeep": openssl rand -base64 48 | tr -d '\n/+='
KARAKEEP_OIDC_CLIENT_SECRET=golden-karakeep-oidc-client-secret
# BentoPDF (pdf.<domain>)
BENTOPDF_TAG=2.8.10

# --- Reading, Files, Share (RUNBOOK.md step 7e; ./files-wizard.sh generates the secrets) ---
# Kavita (read.<domain>): books in MEDIA_DIR/Books/{Books,Comics,Manga,Kids}, read-only
KAVITA_TAG=0.9.1
# Authentik OIDC app "kavita" (authentik/files.yaml): openssl rand -base64 48 | tr -d '\n/+='
KAVITA_OIDC_CLIENT_SECRET=golden-kavita-oidc-client-secret
# OpenCloud (files.<domain>): storage on the second NVMe, bind-mounted here (ansible storage role)
OPENCLOUD_TAG=7.2.4
FILES_DIR=/srv/files
# Sharry (share.<domain>) + its Postgres
SHARRY_TAG=v1.17.0
SHARRY_PG_TAG=18-alpine
# openssl rand -base64 36 | tr -dc A-Za-z0-9
SHARRY_DB_PASSWORD=golden-sharry-db-password
# Signs Sharry's session cookies: echo "b64:$(openssl rand -base64 32 | tr -d '\n')"
SHARRY_SERVER_SECRET=golden-sharry-server-secret
# Authentik OIDC app "sharry": openssl rand -base64 48 | tr -d '\n/+='
SHARRY_OIDC_CLIENT_SECRET=golden-sharry-oidc-client-secret
# Termix (term.<domain>, web SSH terminal, NetBird only, admins only): ghcr.io/termix-ssh/termix
TERMIX_TAG=26.10.5
# Authentik OIDC app "termix": openssl rand -base64 48 | tr -d '\n/+='
TERMIX_OIDC_CLIENT_SECRET=golden-termix-oidc-client-secret

# --- Family apps (RUNBOOK.md step 7f, one component each; ./family-wizard.sh generates the secrets) ---
# Each app's Authentik OIDC client (authentik/<component>.yaml): openssl rand -base64 48 | tr -d '\n/+='
# Donetick (chores.<domain>)
DONETICK_TAG=v0.1.83
DONETICK_OIDC_CLIENT_SECRET=golden-donetick-oidc-client-secret
# Signs its sessions: openssl rand -base64 48 | tr -d '\n'
DONETICK_JWT_SECRET=golden-donetick-jwt-secret
# Homebox (stuff.<domain>)
HOMEBOX_TAG=0.27.1
HOMEBOX_OIDC_CLIENT_SECRET=golden-homebox-oidc-client-secret
# Keys its API key hashes, must never change: openssl rand -base64 48 | tr -d '\n'
HOMEBOX_API_KEY_PEPPER=golden-homebox-api-key-pepper
# Gramps Web (tree.<domain>) + its Celery worker and Valkey
# The tree's name: opened by name, created when missing, so keep it once set (empty = BRAND; the wizard pins it)
GRAMPS_TREE=Example
GRAMPS_TAG=26.10.2
VALKEY_TAG=9.0-alpine
GRAMPS_OIDC_CLIENT_SECRET=golden-gramps-oidc-client-secret
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GRAMPS_SECRET_KEY=golden-gramps-secret-key
# Memos (notes.<domain>): upstream's version; memos/build.sh builds it with our patch
MEMOS_TAG=0.31.0
MEMOS_OIDC_CLIENT_SECRET=golden-memos-oidc-client-secret
# Outline (wiki.<domain>) + its Postgres and Valkey
OUTLINE_TAG=1.12.0
OUTLINE_PG_TAG=18-alpine
OUTLINE_OIDC_CLIENT_SECRET=golden-outline-oidc-client-secret
# Both exactly 64 hex characters: openssl rand -hex 32
OUTLINE_SECRET_KEY=golden-outline-secret-key
OUTLINE_UTILS_SECRET=golden-outline-utils-secret
# openssl rand -base64 36 | tr -dc A-Za-z0-9
OUTLINE_DB_PASSWORD=golden-outline-db-password
# FreshRSS (news.<domain>)
FRESHRSS_TAG=1.30.4
FRESHRSS_OIDC_CLIENT_SECRET=golden-freshrss-oidc-client-secret
# mod_auth_openidc's session key: openssl rand -hex 32
FRESHRSS_OIDC_CRYPTO_KEY=golden-freshrss-oidc-crypto-key
# FreshRSS's admin: your Authentik username, exactly (case included); empty = ADMIN_LOGIN
FRESHRSS_ADMIN_USER=
# RomM (games.<domain>) + MariaDB; games in MEDIA_DIR/Games (roms/<platform>/, bios/)
ROMM_TAG=5.4.1
ROMM_DB_TAG=11.8
ROMM_OIDC_CLIENT_SECRET=golden-romm-oidc-client-secret
# openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=golden-romm-auth-secret-key
# openssl rand -base64 36 | tr -dc A-Za-z0-9 (both)
ROMM_DB_PASSWORD=golden-romm-db-password
ROMM_DB_ROOT_PASSWORD=golden-romm-db-root-password
# Optional, covers and titles: a Twitch developer app (dev.twitch.tv/console/apps), family-wizard.sh asks
ROMM_IGDB_CLIENT_ID=
ROMM_IGDB_CLIENT_SECRET=
# Dawarich (places.<domain>) + PostGIS and Valkey
DAWARICH_TAG=1.17.0
DAWARICH_PG_TAG=17-3.5-alpine
DAWARICH_OIDC_CLIENT_SECRET=golden-dawarich-oidc-client-secret
# openssl rand -hex 64
DAWARICH_SECRET_KEY_BASE=golden-dawarich-secret-key-base
# openssl rand -base64 36 | tr -dc A-Za-z0-9
DAWARICH_DB_PASSWORD=golden-dawarich-db-password
# ntfy (ntfy.<domain>, push notifications, NetBird only): docker.io/binwiederhier/ntfy
NTFY_TAG=v2.34.0
# Access token of ntfy's user n8n (write-only on topic bills): written by ./files-wizard.sh, stage ntfy
NTFY_N8N_TOKEN=tk_goldenntfyn8ntoken0000000000
# n8n (n8n.<domain>, automations, NetBird only, admins only): docker.io/n8nio/n8n
N8N_TAG=2.45.6
# Encrypts n8n's stored credentials; losing it loses them: openssl rand -base64 48 | tr -d '\n/+='
N8N_ENCRYPTION_KEY=golden-n8n-encryption-key
