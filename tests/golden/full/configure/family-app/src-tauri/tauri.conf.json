{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Example",
  "version": "0.1.0",
  "identifier": "com.example.family",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "bash sync-assets.sh",
    "beforeBuildCommand": "bash sync-assets.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "The Example family's apps",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
