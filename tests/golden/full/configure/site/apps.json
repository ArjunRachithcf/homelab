{{- /* ~/homelab/site/apps.json: the signed-in person's apps, rendered by Caddy `templates` behind
     Authentik forward-auth (Caddyfile `(home)`). The one place that decides who sees what:
     index.html reads it (include | fromJson) and the family app (RUNBOOK.md "Family app") fetches it.
     X-Authentik-* headers come from the outpost; Caddy strips client-sent copies first. toJson
     escapes every value.

     layout: "kids" (group kids: their own tiles only), "adult" (family), "none" (no groups yet).
     Each app: id, name, desc, url, icon (/apps/*.svg), status (the /status/<name> check),
     group (watch | docs | home | life | account | admin), netbird (true: only over NetBird), kids (kids' name).
     The app list below is generated by ./homelab configure from the chosen components' [[tiles]]
     (setup/components/*.toml); a new app = a tile there, its status line in
     caddy/components/<id>/status.caddy and its icon in site/apps/. Source: site-src/apps.json. */ -}}
{{- $domain := env "DOMAIN" -}}
{{- /* Public URLs carry NetBird's listen port (PUBLIC_PORT, e.g. 9443) */ -}}
{{- $port := env "PUBLIC_PORT" -}}
{{- if and $port (ne $port "443") }}{{ $port = printf ":%s" $port }}{{ else }}{{ $port = "" }}{{ end -}}
{{- $groups := splitList "|" (.Req.Header.Get "X-Authentik-Groups") -}}
{{- $family := has "family" $groups -}}
{{- $kids := has "kids" $groups -}}
{{- $paperless := has "paperless-users" $groups -}}
{{- $admin := has "authentik Admins" $groups -}}
{{- $operator := or $admin (has "operators" $groups) -}}
{{- $budget := has "budget" $groups -}}
{{- $username := .Req.Header.Get "X-Authentik-Username" -}}
{{- $name := .Req.Header.Get "X-Authentik-Name" -}}
{{- if not $name }}{{ $name = $username }}{{ end -}}
{{- $layout := "none" -}}
{{- if $kids }}{{ $layout = "kids" }}{{ else if $family }}{{ $layout = "adult" }}{{ end -}}
{{- $u := printf "%s%s" $domain $port -}}
{{- $apps := list -}}
{{- if or $family $kids }}
  {{- /* SSO plugin start URL: signs in with the Authentik session, no second login */ -}}
  {{- $apps = append $apps (dict "id" "jellyfin" "name" "Jellyfin" "kids" "Films and shows" "desc" "Films and shows in the browser" "url" (printf "https://jellyfin.%s/sso/OID/start/authentik" $u) "icon" "/apps/jellyfin.svg" "status" "jellyfin" "group" "watch") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "plex" "name" "Plex" "desc" "The same library in the Plex app" "url" "https://app.plex.tv/" "icon" "/apps/plex.svg" "status" "plex" "group" "watch" "netbird" true) -}}
{{- end }}
{{- if or $family $kids }}
  {{- $apps = append $apps (dict "id" "music" "name" "Music" "kids" "Music" "desc" "Your music, in the browser or an app" "url" (printf "https://music.%s/" $u) "icon" "/apps/navidrome.svg" "status" "music" "group" "watch") -}}
{{- end }}
{{- if or $family $kids }}
  {{- $apps = append $apps (dict "id" "books" "name" "Audiobooks" "kids" "Audiobooks" "desc" "Audiobooks and podcasts" "url" (printf "https://books.%s/" $u) "icon" "/apps/audiobookshelf.svg" "status" "books" "group" "watch") -}}
{{- end }}
{{- if or $family $kids }}
  {{- $apps = append $apps (dict "id" "read" "name" "Reading" "kids" "Books and comics" "desc" "Books, comics and manga" "url" (printf "https://read.%s/" $u) "icon" "/apps/kavita.svg" "status" "read" "group" "watch") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "photos" "name" "Photos" "desc" "Photos and videos from your phone" "url" (printf "https://photos.%s/" $u) "icon" "/apps/immich.svg" "status" "photos" "group" "watch") -}}
{{- end }}
{{- if and (or $family $kids) $paperless (not $kids) }}
  {{- $apps = append $apps (dict "id" "paperless" "name" "Paperless" "desc" "Scanned letters and documents" "url" (printf "https://paperless.%s/" $u) "icon" "/apps/paperless-ngx.svg" "status" "paperless" "group" "docs") -}}
{{- end }}
{{- if or $family $kids }}
  {{- $apps = append $apps (dict "id" "files" "name" "Files" "kids" "My files" "desc" "Your files on every device" "url" (printf "https://files.%s/" $u) "icon" "/apps/opencloud.svg" "status" "files" "group" "docs") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "share" "name" "Share" "desc" "Send a file with a link that expires" "url" (printf "https://share.%s/" $u) "icon" "/apps/sharry.svg" "status" "share" "group" "docs") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "links" "name" "Bookmarks" "desc" "Saved links, tagged for you" "url" (printf "https://links.%s/" $u) "icon" "/apps/karakeep.svg" "status" "links" "group" "docs") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) $budget }}
  {{- $apps = append $apps (dict "id" "budget" "name" "Budget" "desc" "Accounts and spending" "url" (printf "https://budget.%s/" $u) "icon" "/apps/actual-budget.svg" "status" "budget" "group" "docs") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- /* NetBird only: HA has no public site */ -}}
  {{- $apps = append $apps (dict "id" "ha" "name" "Home Assistant" "desc" "Lights and devices at home" "url" (printf "https://ha.%s/" $u) "icon" "/apps/home-assistant.svg" "status" "ha" "group" "home" "netbird" true) -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "pdf" "name" "PDF tools" "desc" "Merge, split, sign, on your device" "url" (printf "https://pdf.%s/" $u) "icon" "/apps/bentopdf.svg" "status" "pdf" "group" "home") -}}
{{- end }}
{{- if or $family $kids }}
  {{- $apps = append $apps (dict "id" "chores" "name" "Chores" "kids" "Chores" "desc" "Who does what, and when" "url" (printf "https://chores.%s/" $u) "icon" "/apps/donetick.svg" "status" "chores" "group" "life") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "wiki" "name" "Wiki" "desc" "How-tos and family plans" "url" (printf "https://wiki.%s/" $u) "icon" "/apps/outline.svg" "status" "wiki" "group" "life") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "notes" "name" "Notes" "desc" "Quick notes, just for you" "url" (printf "https://notes.%s/" $u) "icon" "/apps/memos.png" "status" "notes" "group" "life") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "stuff" "name" "Things" "desc" "What we own and where" "url" (printf "https://stuff.%s/" $u) "icon" "/apps/homebox.svg" "status" "stuff" "group" "life") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "tree" "name" "Family tree" "desc" "Relatives and their stories" "url" (printf "https://tree.%s/" $u) "icon" "/apps/gramps-web.svg" "status" "tree" "group" "life") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "news" "name" "News" "desc" "Feeds and blogs you follow" "url" (printf "https://news.%s/" $u) "icon" "/apps/freshrss.svg" "status" "news" "group" "life") -}}
{{- end }}
{{- if and (or $family $kids) (not $kids) }}
  {{- $apps = append $apps (dict "id" "places" "name" "Places" "desc" "Where you've been" "url" (printf "https://places.%s/" $u) "icon" "/apps/dawarich.svg" "status" "places" "group" "life") -}}
{{- end }}
{{- if or $family $kids }}
  {{- $apps = append $apps (dict "id" "games" "name" "Games" "kids" "Games" "desc" "Old console games" "url" (printf "https://games.%s/" $u) "icon" "/apps/romm.svg" "status" "games" "group" "life") -}}
{{- end }}
{{- if not $kids }}
  {{- $apps = append $apps (dict "id" "account" "name" "My account" "desc" "Password and authenticator" "url" (printf "https://auth.%s/if/user/" $u) "icon" "/mark.png" "status" "auth" "group" "account") -}}
{{- end }}
{{- if not $kids }}
  {{- /* Authentik's passkey setup flow. On a signed-in computer the browser can save it to a phone (QR code) or a security key: that's how a new phone gets a passkey. */ -}}
  {{- $apps = append $apps (dict "id" "passkey" "name" "Add a passkey" "desc" "For this device or a new phone" "url" (printf "https://auth.%s/if/flow/default-authenticator-webauthn-setup/" $u) "icon" "/mark.png" "status" "auth" "group" "account") -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "admin" "name" "Accounts admin" "desc" "People, groups and sign-in rules" "url" (printf "https://auth.%s/if/admin/" $u) "icon" "/apps/authentik.svg" "status" "auth" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $operator (not $kids) }}
  {{- /* The console (site/console/): admins and the operators group; restarts and runs only over NetBird. */ -}}
  {{- $apps = append $apps (dict "id" "console" "name" "Console" "desc" "Jobs, apps, logs and what to do" "url" (printf "https://home.%s/console/" $u) "icon" "/apps/console.svg" "status" "ops" "group" "admin") -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "dns" "name" "Ad blocking" "desc" "AdGuard Home for NetBird devices" "url" (printf "https://dns.%s/" $u) "icon" "/apps/adguard-home.svg" "status" "dns" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "term" "name" "Terminal" "desc" "SSH into this PC from the browser" "url" (printf "https://term.%s/" $u) "icon" "/apps/termix.svg" "status" "term" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "ntfy" "name" "Notifications" "desc" "Push messages to your phone" "url" (printf "https://ntfy.%s/" $u) "icon" "/apps/ntfy.svg" "status" "ntfy" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "n8n" "name" "Automations" "desc" "Workflows" "url" (printf "https://n8n.%s/" $u) "icon" "/apps/n8n.svg" "status" "n8n" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "qbit" "name" "Downloads" "desc" "qBittorrent, behind the VPN" "url" (printf "https://qbit.%s/" $u) "icon" "/apps/qbittorrent.svg" "status" "qbit" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "prowlarr" "name" "Search sites" "desc" "Prowlarr, behind the VPN" "url" (printf "https://prowlarr.%s/" $u) "icon" "/apps/prowlarr.svg" "status" "prowlarr" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "radarr" "name" "Movies" "desc" "Radarr: films on request" "url" (printf "https://radarr.%s/" $u) "icon" "/apps/radarr.svg" "status" "radarr" "group" "admin" "netbird" true) -}}
{{- end }}
{{- if and $admin (not $kids) }}
  {{- $apps = append $apps (dict "id" "sonarr" "name" "TV" "desc" "Sonarr: series on request" "url" (printf "https://sonarr.%s/" $u) "icon" "/apps/sonarr.svg" "status" "sonarr" "group" "admin" "netbird" true) -}}
{{- end }}
{{- /* Outside status (heartbeat.sh → status/heartbeat.json). Everyone gets ok + the time; the
     list of what failed only goes to admins. */ -}}
{{- $health := dict "known" false -}}
{{- if fileExists "/status/heartbeat.json" }}
  {{- $hb := readFile "/status/heartbeat.json" | fromJson -}}
  {{- $health = dict "known" true "time" $hb.time "ok" $hb.ok "outside" $hb.outside -}}
  {{- if $admin }}{{ $_ := set $health "problems" $hb.problems }}{{ $_ := set $health "backup_time" $hb.backup_time }}{{ $_ := set $health "disks" $hb.disks }}{{ end -}}
{{- end }}
{{- dict "user" (dict "name" $name "username" $username "admin" $admin "operator" $operator) "layout" $layout "apps" $apps "health" $health "domain" $domain | toJson }}
