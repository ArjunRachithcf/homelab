# /etc/systemd/system/homelab-ops.service (RUNBOOK.md 7e, "Details"): ops-run.sh runs the requested
# jobs (Back up now, the three cleanups), each a fixed command; started by homelab-ops.path.
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab: jobs requested from the home page
OnFailure=homelab-notify@%n.service
After=docker.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/home/alex/homelab
Environment=PHOTOS_COPY_DIR=/srv/photos-copy
Environment=FILES_COPY_DIR=/srv/files-copy
# Through bash: systemd may not execute a file labelled user_home_t directly (SELinux)
ExecStart=/usr/bin/bash /home/alex/homelab/ops-run.sh
# rsync and rm on the copies run as the admin's login context, as in homelab-photos-local
SELinuxContext=unconfined_u:unconfined_r:unconfined_t:s0
TimeoutStartSec=3h
