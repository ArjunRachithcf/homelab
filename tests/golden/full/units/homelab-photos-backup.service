# /etc/systemd/system/homelab-photos-backup.service (RUNBOOK.md step 9)
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab off-box copy to Proton Drive (photos, encrypted backups)
OnFailure=homelab-notify@%n.service
Wants=network-online.target
After=network-online.target homelab-backup.service homelab-photos-local.service
RequiresMountsFor=/srv/photos

[Service]
Type=oneshot
User=alex
WorkingDirectory=/home/alex/homelab
# Through bash: systemd may not execute a file labelled user_home_t directly (SELinux)
ExecStart=/usr/bin/bash /home/alex/homelab/backup-photos.sh
Nice=10
IOSchedulingClass=idle
