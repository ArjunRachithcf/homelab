# /etc/systemd/system/homelab-ssh-keys.timer: every 15 minutes (component ssh-sso), for keys changed elsewhere than
# the sheet (the command line, Authentik's admin UI); the sheet itself asks through homelab-ssh-keys.path.
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab SSH keys

[Timer]
OnCalendar=*:7/15
AccuracySec=30s

[Install]
WantedBy=timers.target
