// /etc/polkit-1/rules.d/50-homelab-backups.rules: lets backup-watch.sh (as alex)
// start exactly these three backup units, nothing else. RUNBOOK.md step 9.
// Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
polkit.addRule(function(action, subject) {
  var units = ["homelab-backup.service", "homelab-photos-copy.service", "homelab-offbox.service"];
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.user == "alex" &&
      action.lookup("verb") == "start" &&
      units.indexOf(action.lookup("unit")) >= 0) {
    return polkit.Result.YES;
  }
});
