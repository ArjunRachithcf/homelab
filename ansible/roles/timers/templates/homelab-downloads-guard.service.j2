# /etc/systemd/system/homelab-downloads-guard.service (component downloads): downloads/guard.sh. Fails, so it mails
# once, when it has just stopped the torrents (disk low) or couldn't bring qBittorrent back.
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab downloads: disk guard, qBittorrent and Prowlarr back after a VPN restart
OnFailure=homelab-notify@%n.service
After=docker.service

[Service]
Type=oneshot
User={{ homelab_user }}
WorkingDirectory={{ homelab_dir }}
# Through bash: systemd may not execute a file labelled user_home_t directly (SELinux)
ExecStart=/usr/bin/bash {{ homelab_dir }}/downloads/guard.sh
TimeoutStartSec=5min
