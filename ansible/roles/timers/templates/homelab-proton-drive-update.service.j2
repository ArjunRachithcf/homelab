# /etc/systemd/system/homelab-proton-drive-update.service (proton-drive/README.md)
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab: update the official + patched Proton Drive CLI
OnFailure=homelab-notify@%n.service
Wants=network-online.target
After=network-online.target
Before=homelab-photos-backup.service

[Service]
Type=oneshot
User={{ homelab_user }}
WorkingDirectory={{ homelab_dir }}
# Through bash: systemd may not execute a file labelled user_home_t directly (SELinux)
ExecStart=/usr/bin/bash {{ homelab_dir }}/proton-drive/update.sh
Nice=10
