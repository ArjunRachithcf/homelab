# /etc/systemd/system/homelab-heartbeat.service (RUNBOOK.md step 7d): heartbeat.sh, pings
# healthchecks.io (OK or /fail with what's wrong). No OnFailure mail: when the ping itself can't get
# out, healthchecks.io notices the silence and mails instead (a local mail every 5 min would be spam).
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab: heartbeat to healthchecks.io
After=docker.service netbird.service

[Service]
Type=oneshot
User={{ homelab_user }}
WorkingDirectory={{ homelab_dir }}
# Through bash: systemd may not execute a file labelled user_home_t directly (SELinux)
ExecStart=/usr/bin/bash {{ homelab_dir }}/heartbeat.sh
TimeoutStartSec=3min
