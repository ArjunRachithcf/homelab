# /etc/systemd/system/homelab-storage-report.service (RUNBOOK.md 7e, "Details"): storage-report.py,
# what uses the disks and what each cleanup would free, for the home page's Disk sheet. Read-only.
# Written by Ansible from ansible/roles/timers/templates: edit there, then --tags timers.
[Unit]
Description=Homelab: disk usage report
After=docker.service

[Service]
Type=oneshot
User={{ homelab_user }}
WorkingDirectory={{ homelab_dir }}
Environment=NVME1_DIR={{ nvme1_dir }}
Environment=PHOTOS_COPY_DIR={{ photos_copy_dir }}
Environment=FILES_COPY_DIR={{ files_copy_dir }}
ExecStart=/usr/bin/python3 {{ homelab_dir }}/storage-report.py
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
