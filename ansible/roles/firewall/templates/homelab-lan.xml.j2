<?xml version="1.0" encoding="utf-8"?>
<!-- /etc/firewalld/zones/homelab-lan.xml. Written by Ansible from ansible/roles/firewall/templates:
     edit there (or LAN_ALLOW in .env), then run the playbook's firewall tag. -->
<zone>
  <short>Homelab LAN</short>
  <description>firewalld's default zone, so every interface no other zone claims: the LAN. The homelab answers only on its NetBird address (wt0, zone trusted); here only what this machine itself needs, and LAN_ALLOW in .env.</description>
{% for s in firewall_lan_services + (lan_allow | reject('search', '/') | list) %}
  <service name="{{ s }}"/>
{% endfor %}
{% for p in lan_allow | select('search', '/') %}
  <port port="{{ p.split('/')[0] }}" protocol="{{ p.split('/')[1] }}"/>
{% endfor %}
{% if smarthome_enabled %}
  <!-- Matter (Home Assistant): matter.js picks a random operational port at every start, so its devices
       get in by their own port 5540, over IPv6 only (Matter has no IPv4) -->
  <rule family="ipv6">
    <source-port port="5540" protocol="udp"/>
    <accept/>
  </rule>
{% endif %}
</zone>
