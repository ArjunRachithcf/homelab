# caddy/components/subtitles/sites.caddy (component subtitles; copied into caddy/enabled/ by ./homelab configure)
# Bazarr: NetBird only (no :8444 site, no NetBird service, DNS zone for the Admin group only), admins only (its
# Authentik app), every path behind forward-auth. Its own login is HTTP Basic, which Caddy fills in only after that
# (BAZARR_AUTH, docker-compose.yml): one sign-in, Authentik's. Whatever the browser sends there is replaced.
(bazarr) {
	route {
		import forward_auth
		reverse_proxy bazarr:6767 {
			header_up Authorization "Basic {env.BAZARR_AUTH}"
		}
	}
}

subs.{$DOMAIN}:{$PUBLIC_PORT} {
	import headers
	import bazarr
}

subs.{$DOMAIN}, subs.{$DOMAIN_ALIAS}, subs.{$DOMAIN_ALIAS}:{$PUBLIC_PORT} {
	import headers
	import canonical subs
}
