+export const CREDENTIALS_SERVICE = 'homelab/proton-photos';
 export const CREDENTIALS_NAME = 'auth-session';
 export const PASS_CREDENTIALS_PATH = `${CREDENTIALS_SERVICE}/${CREDENTIALS_NAME}`;
