 	"github.com/pkg/errors"
 	"golang.org/x/crypto/bcrypt"
@@ -317,3 +319,27 @@ func (s *APIV1Service) bindSSOIdentityToUser(ctx context.Context, currentUser *s
 // 2. Stores refresh token metadata in user_setting.
 // 3. Sets refresh token as HttpOnly cookie.
 // 4. Returns access token and its expiry time.
+
+// syncSSORole makes an SSO user ADMIN while the identity provider puts them in the group
+// MEMOS_SSO_ADMIN_GROUP, and USER otherwise; checked at every SSO sign-in, so the provider decides.
+// Unset, roles are left alone (upstream behaviour).
+func (s *APIV1Service) syncSSORole(ctx context.Context, user *store.User, userInfo *idp.IdentityProviderUserInfo) (*store.User, error) {
+	group := os.Getenv("MEMOS_SSO_ADMIN_GROUP")
+	if group == "" {
+		return user, nil
+	}
+	role := store.RoleUser
+	if slices.Contains(userInfo.Groups, group) {
+		role = store.RoleAdmin
+	}
+	if user.Role == role {
+		return user, nil
+	}
+	updated, err := s.Store.UpdateUser(ctx, &store.UpdateUser{ID: user.ID, Role: &role})
+	if err != nil {
+		return nil, status.Errorf(codes.Internal, "failed to update user role, error: %v", err)
+	}
+	slog.Info("identity provider group changed the user's role",
+		slog.String("username", user.Username), slog.String("role", string(role)))
+	return updated, nil
+}
diff --git a/server/api/v1/test/sso_admin_group_test.go b/server/api/v1/test/sso_admin_group_test.go
new file mode 100644
index 0000000..9a92c1e
--- /dev/null
+++ b/server/api/v1/test/sso_admin_group_test.go
@@ -0,0 +1,113 @@
+package test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	v1pb "github.com/usememos/memos/proto/gen/api/v1"
+	storepb "github.com/usememos/memos/proto/gen/store"
+	"github.com/usememos/memos/store"
+)
+
+// An identity provider whose "groups" claim can change between sign-ins.
+func newGroupsOAuthServer(t *testing.T, sub string, groups *[]string) *httptest.Server {
+	t.Helper()
+	mux := http.NewServeMux()
+	mux.HandleFunc("/oauth2/token", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		require.NoError(t, json.NewEncoder(w).Encode(map[string]any{"access_token": "token", "token_type": "Bearer", "expires_in": 3600}))
+	})
+	mux.HandleFunc("/oauth2/userinfo", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		require.NoError(t, json.NewEncoder(w).Encode(map[string]any{"sub": sub, "name": sub, "email": sub + "@example.com", "groups": *groups}))
+	})
+	return httptest.NewServer(mux)
+}
+
+func TestSSOAdminGroupGrantsAndRevokesAdmin(t *testing.T) {
+	t.Setenv("MEMOS_SSO_ADMIN_GROUP", "authentik Admins")
+	ts := NewTestService(t)
+	defer ts.Cleanup()
+	ctx := context.Background()
+
+	groups := []string{"family", "authentik Admins"}
+	server := newGroupsOAuthServer(t, "alex", &groups)
+	defer server.Close()
+	idpName := createTestingOAuthIdentityProvider(ctx, t, ts, server.URL, "authentik")
+
+	response, err := signInWithTestingSSO(ctx, ts, idpName, "code")
+	require.NoError(t, err)
+	require.Equal(t, v1pb.User_ADMIN, response.User.Role, "in the admin group: admin from the first sign-in")
+
+	groups = []string{"family"}
+	response, err = signInWithTestingSSO(ctx, ts, idpName, "code")
+	require.NoError(t, err)
+	require.Equal(t, v1pb.User_USER, response.User.Role, "left the admin group: plain user at the next sign-in")
+}
+
+func TestSSORoleUntouchedWithoutAdminGroup(t *testing.T) {
+	t.Setenv("MEMOS_SSO_ADMIN_GROUP", "")
+	ts := NewTestService(t)
+	defer ts.Cleanup()
+	ctx := context.Background()
+
+	groups := []string{"authentik Admins"}
+	server := newGroupsOAuthServer(t, "alice", &groups)
+	defer server.Close()
+	idpName := createTestingOAuthIdentityProvider(ctx, t, ts, server.URL, "authentik")
+
+	response, err := signInWithTestingSSO(ctx, ts, idpName, "code")
+	require.NoError(t, err)
+	require.Equal(t, v1pb.User_USER, response.User.Role)
+}
+
+func disallowPasswordAuth(ctx context.Context, t *testing.T, ts *TestService) {
+	t.Helper()
+	_, err := ts.Store.UpsertInstanceSetting(ctx, &storepb.InstanceSetting{
+		Key: storepb.InstanceSettingKey_GENERAL,
+		Value: &storepb.InstanceSetting_GeneralSetting{
+			GeneralSetting: &storepb.InstanceGeneralSetting{DisallowPasswordAuth: true},
+		},
+	})
+	require.NoError(t, err)
+}
+
+func TestPasswordSignInRefusedForAdminsWhenPasswordAuthOff(t *testing.T) {
+	ts := NewTestService(t)
+	defer ts.Cleanup()
+	ctx := context.Background()
+
+	_, err := ts.Service.CreateUser(ctx, &v1pb.CreateUserRequest{
+		User: &v1pb.User{Username: "admin", Email: "admin@example.com", Password: "password123"},
+	})
+	require.NoError(t, err)
+	admin, err := ts.Store.GetUser(ctx, &store.FindUser{Username: ptr("admin")})
+	require.NoError(t, err)
+	require.Equal(t, store.RoleAdmin, admin.Role)
+
+	disallowPasswordAuth(ctx, t, ts)
+	err = passwordSignIn(ctx, ts, "admin", "password123")
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "password signin is not allowed")
+}
+
+func TestFirstUserPasswordSignUpRefusedWhenPasswordAuthOff(t *testing.T) {
+	ts := NewTestService(t)
+	defer ts.Cleanup()
+	ctx := context.Background()
+
+	disallowPasswordAuth(ctx, t, ts)
+	_, err := ts.Service.CreateUser(ctx, &v1pb.CreateUserRequest{
+		User: &v1pb.User{Username: "first", Email: "first@example.com", Password: "password123"},
+	})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "password signup is not allowed")
+	users, err := ts.Store.ListUsers(ctx, &store.FindUser{})
+	require.NoError(t, err)
+	require.Empty(t, users)
+}
