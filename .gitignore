# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Secrets and data: never committed
.env
backups/
export/
consume/
*.pre-*
ssh/ldap-ssh.pem
.claude/settings.local.json
# This machine's instance notes (CLAUDE.md imports them): a copy of docs/instance/INSTANCE.example.md,
# or a symlink to an instance kept in docs/instance/ (the owner's: docs/instance/INSTANCE.md)
/INSTANCE.md
# An instance's own private repository (docs/instance/README.md), and its runbook linked into place
/instance/
/RUNBOOK.md

# heartbeat.sh output (home page status), rewritten every 5 min
site/status/
# tasteskill working files (design sheet, inspector screenshots)
.taste-skill/
# Reports and job requests for the detail sheets (RUNBOOK.md 7e)
ops/data/
ops/requests/
ops/keys/

# Rendered from .env by ./homelab configure (sources: */templates-src, site-src, ui-src, BRANDING_DIR)
authentik/templates/
authentik/mail-logo.png
/site/logo.png
/site/logo-*.png
/site/mark.png
/site/favicon.png
/site/apple-touch-icon.png
/site/icon-192.png
/site/icon-512.png
/site/manifest.webmanifest
/site/apps.json
/family-app/src-tauri/icons/
/family-app/src-tauri/tauri.conf.json
/family-app/ui/index.html
/caddy/enabled/
/recyclarr/configs/

# Python bytecode (lib/, ansible/lookup_plugins/)
__pycache__/
# npm packages for the tests that drive a browser (CI: npm install --no-save playwright)
node_modules/
# The setup app's build output (setup-app/)
/setup-app/src-tauri/target/
/setup-app/src-tauri/gen/
/setup-app/src-tauri/permissions/autogenerated/
